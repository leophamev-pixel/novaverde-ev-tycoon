rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Hồ sơ Cloud Save đa thiết bị (Mac / Mobile / Web) - Kiểm tra Anti-Cheat 1x Speed
    match /users/{userId} {
      allow read: if true;
      allow create, update, write: if request.resource.data.gameSpeed == 1
                                   && (
                                     (request.resource.data.ownedLots >= 1 && request.resource.data.ownedLots <= 5400) ||
                                     (request.resource.data.ownedLotsCount >= 1 && request.resource.data.ownedLotsCount <= 5400)
                                   );
    }

    // 2. Bảng Xếp Hạng Toàn Cầu (Top 100 CEO) - Kiểm tra Anti-Cheat 1x Speed
    match /leaderboards/{userId} {
      allow read: if true;
      allow create, update, write: if request.resource.data.gameSpeed == 1
                                   && request.resource.data.ownedLots >= 1
                                   && request.resource.data.ownedLots <= 5400
                                   && request.resource.data.totalChargers >= 1
                                   && request.resource.data.netWorth >= 0;
    }
  }
}
